# Generate with: npm run gen-key
# Never commit the real key.
FAUCET_HEX_PRIVKEY=

NETWORK=mainnet
NODE_ENV=production
# Prefer a node you run. The official testnet faucet uses 127.0.0.1:3001.
NODE_URL=http://127.0.0.1:3001
PORT=3000
TRUST_PROXY=loopback
CORS_ORIGIN=https://warthog.network,http://localhost:3000

DRIP_AMOUNT=2
WEEKLY_BUDGET=10
MIN_RESERVE=1
WALLET_WINDOW_HOURS=876000
IP_RATE_LIMIT=1
IP_WINDOW_HOURS=24
BALANCE_POLL_MS=60000
CLAIMS_FILE=./data/claims.json
